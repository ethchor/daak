# Copy to .env. Development only — this password protects nothing real, and
# nothing that touches a real account may ever be configured here. Credentials
# that matter live in the OS keychain (ARCHITECTURE.md, security model).
STALWART_ADMIN_SECRET=daak-dev-not-a-real-secret

# Pinned rather than `latest`. Stalwart changed how it is configured between
# 0.15 and 0.16 — a settings file became a data-store pointer — so an
# unpinned image would break this compose file on an upgrade, in a way whose
# error message ("missing field `@type`") says nothing about the cause.
STALWART_VERSION=0.16.20
